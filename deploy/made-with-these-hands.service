[Unit]
Description=Made With These Hands Next.js app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/made-with-these-hands/current
EnvironmentFile=-%h/.config/made-with-these-hands/production.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3009
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target
