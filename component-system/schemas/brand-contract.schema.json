{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madewiththesehands.local/schemas/brand-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "palette", "typography", "voice", "imagery", "usage", "component_contract"],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "fontRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "stack", "role"],
      "properties": {
        "family": { "$ref": "#/$defs/nonEmptyString" },
        "stack": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "colourTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "paper_2",
        "paper_3",
        "ink",
        "ink_80",
        "ink_60",
        "ink_40",
        "ink_20",
        "rule",
        "accent",
        "white"
      ],
      "properties": {
        "paper": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "paper_2": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "paper_3": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "ink": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "ink_80": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "ink_60": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "ink_40": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "ink_20": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "rule": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "white": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    }
  },
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "descriptor", "essence", "story", "promise", "principles"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "descriptor": { "$ref": "#/$defs/nonEmptyString" },
        "essence": { "$ref": "#/$defs/nonEmptyString" },
        "story": { "$ref": "#/$defs/nonEmptyString" },
        "promise": { "$ref": "#/$defs/nonEmptyString" },
        "principles": { "$ref": "#/$defs/stringList" }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "palettes"],
      "properties": {
        "active": { "$ref": "#/$defs/nonEmptyString" },
        "palettes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "tokens"],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmptyString" },
              "description": { "$ref": "#/$defs/nonEmptyString" },
              "tokens": { "$ref": "#/$defs/colourTokens" }
            }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "body", "utility", "rules"],
      "properties": {
        "display": { "$ref": "#/$defs/fontRole" },
        "body": { "$ref": "#/$defs/fontRole" },
        "utility": { "$ref": "#/$defs/fontRole" },
        "rules": { "$ref": "#/$defs/stringList" }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "sounds_like", "avoid", "example"],
      "properties": {
        "character": { "$ref": "#/$defs/stringList" },
        "sounds_like": { "$ref": "#/$defs/stringList" },
        "avoid": { "$ref": "#/$defs/stringList" },
        "example": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "imagery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "subjects", "light", "composition", "avoid"],
      "properties": {
        "direction": { "$ref": "#/$defs/nonEmptyString" },
        "subjects": { "$ref": "#/$defs/stringList" },
        "light": { "$ref": "#/$defs/nonEmptyString" },
        "composition": { "$ref": "#/$defs/nonEmptyString" },
        "avoid": { "$ref": "#/$defs/stringList" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent_rule", "surface_rule", "interaction_rule", "accessibility"],
      "properties": {
        "accent_rule": { "$ref": "#/$defs/nonEmptyString" },
        "surface_rule": { "$ref": "#/$defs/nonEmptyString" },
        "interaction_rule": { "$ref": "#/$defs/nonEmptyString" },
        "accessibility": { "$ref": "#/$defs/stringList" }
      }
    },
    "component_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "spacing",
        "composition",
        "grids",
        "image_ratios",
        "motion",
        "buttons",
        "component_sources",
        "mobile",
        "accessibility",
        "nesting",
        "performance"
      ],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_unit_px",
            "scale_px",
            "density_choices",
            "density_tokens",
            "section_inline",
            "section_block",
            "control_target_minimum"
          ],
          "properties": {
            "base_unit_px": { "const": 4 },
            "scale_px": {
              "type": "object",
              "additionalProperties": false,
              "required": ["space_0", "space_1", "space_2", "space_3", "space_4", "space_5", "space_6", "space_7", "space_8", "space_9", "space_10"],
              "properties": {
                "space_0": { "const": 0 },
                "space_1": { "const": 4 },
                "space_2": { "const": 8 },
                "space_3": { "const": 12 },
                "space_4": { "const": 16 },
                "space_5": { "const": 24 },
                "space_6": { "const": 32 },
                "space_7": { "const": 48 },
                "space_8": { "const": 64 },
                "space_9": { "const": 96 },
                "space_10": { "const": 128 }
              }
            },
            "density_choices": { "const": ["compact", "standard", "generous"] },
            "density_tokens": {
              "type": "object",
              "additionalProperties": false,
              "required": ["compact", "standard", "generous"],
              "properties": {
                "compact": { "const": { "inline": "space_5", "block": "space_8", "gap": "space_4" } },
                "standard": { "const": { "inline": "space_8", "block": "space_9", "gap": "space_6" } },
                "generous": { "const": { "inline": "space_9", "block": "space_10", "gap": "space_7" } }
              }
            },
            "section_inline": { "$ref": "#/$defs/nonEmptyString" },
            "section_block": { "$ref": "#/$defs/nonEmptyString" },
            "control_target_minimum": { "type": "string", "pattern": "^[4-9][0-9]px$" }
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directus_spacing_field",
            "raw_css_in_cms",
            "raw_numeric_spacing_in_cms",
            "approved_grids_only",
            "nested_cards"
          ],
          "properties": {
            "directus_spacing_field": { "const": "spacing" },
            "raw_css_in_cms": { "const": false },
            "raw_numeric_spacing_in_cms": { "const": false },
            "approved_grids_only": { "const": true },
            "nested_cards": { "const": false }
          }
        },
        "grids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["single-column", "editorial-split", "two-column", "three-column", "archive-row"]
          }
        },
        "image_ratios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+ / [0-9]+$" }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durations_ms", "autoplay_minimum_interval_ms", "reduced_motion_required"],
          "properties": {
            "durations_ms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 1000 }
            },
            "autoplay_minimum_interval_ms": { "type": "integer", "minimum": 4000 },
            "reduced_motion_required": { "const": true }
          }
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["primaryAction", "secondaryAction", "carouselControl"] }
        },
        "component_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preferred", "fallback", "base"],
          "properties": {
            "preferred": { "const": "shadcn" },
            "fallback": { "const": "bespoke-after-documented-gap" },
            "base": { "const": "radix" }
          }
        },
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_breakpoint_px", "compact_breakpoint_px", "horizontal_overflow"],
          "properties": {
            "primary_breakpoint_px": { "type": "integer", "minimum": 640 },
            "compact_breakpoint_px": { "type": "integer", "minimum": 320 },
            "horizontal_overflow": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible_focus", "keyboard_operable", "alt_text_required", "colour_alone_forbidden"],
          "properties": {
            "visible_focus": { "const": true },
            "keyboard_operable": { "const": true },
            "alt_text_required": { "const": true },
            "colour_alone_forbidden": { "const": true }
          }
        },
        "nesting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page_slots", "executable_content_in_cms"],
          "properties": {
            "page_slots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["main", "before-content", "after-content", "related-content"] }
            },
            "executable_content_in_cms": { "const": false }
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_slides", "stable_media_dimensions", "responsive_images"],
          "properties": {
            "maximum_slides": { "type": "integer", "minimum": 1, "maximum": 12 },
            "stable_media_dimensions": { "const": true },
            "responsive_images": { "const": true }
          }
        }
      }
    }
  }
}
