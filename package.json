{
  "name": "made-with-these-hands",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "directus:bootstrap": "node scripts/bootstrap-directus-mwth.mjs",
    "directus:seed": "node scripts/seed-directus-mwth.mjs",
    "directus:brand": "node scripts/seed-directus-brand.mjs",
    "directus:brand-page": "node scripts/seed-directus-brand-page.mjs",
    "directus:dashboard-demo": "node --env-file-if-exists=.env.local scripts/seed-directus-dashboard-demo.mjs",
    "directus:owner-acceptance": "node --env-file-if-exists=.env.local scripts/seed-directus-owner-acceptance.mjs",
    "owner-acceptance:run": "node --env-file-if-exists=.env.local scripts/run-owner-acceptance-mcp.mjs",
    "directus:podcast-sync": "node --env-file-if-exists=.env.local scripts/sync-podcast-rss.mjs",
    "directus:guest-review": "node --env-file-if-exists=.env.local scripts/prepare-podcast-guest-review.mjs",
    "directus:guest-review:apply": "node --env-file-if-exists=.env.local scripts/prepare-podcast-guest-review.mjs --apply",
    "directus:content-audit": "node --env-file-if-exists=.env.local scripts/audit-directus-content-readiness.mjs",
    "directus:content-complete": "node --env-file-if-exists=.env.local scripts/complete-published-content.mjs",
    "directus:generic-blocks": "node --env-file-if-exists=.env.local scripts/migrate-directus-generic-blocks.mjs",
    "directus:generic-blocks:apply": "node --env-file-if-exists=.env.local scripts/migrate-directus-generic-blocks.mjs --apply",
    "directus:design-contract": "node --env-file-if-exists=.env.local scripts/migrate-directus-design-contract.mjs",
    "directus:design-contract:apply": "node --env-file-if-exists=.env.local scripts/migrate-directus-design-contract.mjs --apply",
    "production:readiness": "node --env-file-if-exists=.env.local scripts/verify-production-readiness.mjs",
    "enquiries:send-test": "node --env-file-if-exists=.env.local scripts/verify-production-readiness.mjs --send-test-enquiry",
    "directus:component-registry": "node scripts/seed-component-registry.mjs",
    "directus:site-token": "node scripts/create-directus-site-token.mjs",
    "directus:mcp-user": "node scripts/create-directus-mcp-user.mjs",
    "components:validate-brand": "node scripts/validate-brand-contract.mjs",
    "migration:validate": "node scripts/validate-migration-intake.mjs",
    "components:validate": "npm run components:validate-brand && node scripts/validate-components.mjs",
    "components:validate-live": "node --env-file-if-exists=.env.local scripts/validate-directus-component-system.mjs",
    "components:validate-policy": "node --env-file-if-exists=.env.local scripts/validate-directus-mcp-policy.mjs",
    "components:test": "node --test component-system/tests/*.test.mjs",
    "components:smoke": "node --env-file-if-exists=.env.local scripts/smoke-test-built-site.mjs",
    "components:verify": "npm run components:validate && npm run components:validate-live && npm run components:test && npm audit --audit-level=high && npm run build && npm run components:smoke",
    "registry:validate": "shadcn registry validate ./registry.json",
    "registry:build": "shadcn build ./registry.json -o ./public/r",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:verify": "npm run registry:validate && npm run registry:build && npm run storybook:build",
    "system:verify": "npm run components:verify && npm run storybook:verify",
    "component-factory:mcp": "node tools/component-factory-mcp/index.mjs",
    "component-factory:remote": "node tools/component-factory-mcp/remote.mjs",
    "component-factory:token": "node tools/component-factory-mcp/generate-client-token.mjs",
    "component-factory:provision-local": "node tools/component-factory-mcp/provision-local-client.mjs",
    "component-factory:verify-local": "node tools/component-factory-mcp/verify-local-client.mjs",
    "client-access:verify": "node scripts/verify-client-codex-access.mjs",
    "client-access:rotate": "node --env-file-if-exists=.env.local scripts/rotate-client-access-tokens.mjs"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.0",
    "@directus/sdk": "^21.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.0",
    "html-to-text": "^9.0.5",
    "lucide-react": "^1.27.0",
    "media-chrome": "^4.19.2",
    "next": "^16.2.12",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.1.18",
    "shadcn": "^4.15.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.18"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
